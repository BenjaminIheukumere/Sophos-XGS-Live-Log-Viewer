<Window x:Class="SophosXgsLiveLogViewer.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sophos XGS Live Log Viewer by Benjamin Iheukumere | Safelink IT - About"
        Height="500"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="Assets/AppIcon.ico"
        Background="{StaticResource AppSurfaceBrush}">
    <Border Margin="18"
            Padding="20"
            Background="{StaticResource PanelSurfaceBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{StaticResource AccentGlow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Border Width="68"
                        Height="68"
                        DockPanel.Dock="Left"
                        Margin="0,0,14,0"
                        Background="Transparent"
                        BorderThickness="0">
                    <Image Source="Assets/AppIcon.png"
                           Width="64"
                           Height="64"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Sophos XGS Live Log Viewer"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="by Benjamin Iheukumere | Safelink IT"
                               FontSize="14"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,18"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="On-demand near-real-time Sophos XGS log viewer for troubleshooting over SSH. Feature requests are welcome; use any contact option below to send them over." />

            <StackPanel Grid.Row="2">
                <TextBlock Text="Contact"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <TextBlock Text="Benjamin Iheukumere | Safelink IT" Margin="0,0,0,8" />

                <TextBlock Margin="0,0,0,8">
                    <Run Text="Website: " />
                    <Hyperlink NavigateUri="https://safelink-it.com" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="https://safelink-it.com" />
                    </Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,0,0,8">
                    <Run Text="Tel.: " />
                    <Hyperlink NavigateUri="tel:+491773555059" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="+49 177 3 555 059" />
                    </Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,0,0,8">
                    <Run Text="Email: " />
                    <Hyperlink NavigateUri="mailto:b.iheukumere@safelink-it.com" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="b.iheukumere@safelink-it.com" />
                    </Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,0,0,8">
                    <Run Text="LinkedIn: " />
                    <Hyperlink NavigateUri="https://www.linkedin.com/in/benjamin-iheukumere/" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="https://www.linkedin.com/in/benjamin-iheukumere/" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Close"
                        MinWidth="90"
                        IsDefault="True"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
